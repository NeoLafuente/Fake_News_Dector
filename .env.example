# ==========================================================================
#  FactX Agent — configuración
#  Copia a .env y rellena. El .env NUNCA se sube al repo ni a la imagen.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. SECRETOS OBLIGATORIOS — la app se niega a arrancar sin ellos
# --------------------------------------------------------------------------
# openssl rand -hex 32
SECRET_KEY=""
# La credencial que repartes a los usuarios para llegar a la pantalla de espera
GATE_PASSWORD=""
# Solo tuya: da acceso a /admin. openssl rand -hex 32
ADMIN_TOKEN=""

# --------------------------------------------------------------------------
# 2. CLAVES DE SERVICIOS
# --------------------------------------------------------------------------
# Gemini (aistudio.google.com) — gratis, sin tarjeta
GOOGLE_API_KEY=""
# Modelo. Flash-Lite tiene MUCHA más cuota gratuita que Flash.
GEMINI_MODEL="gemini-flash-lite-latest"
GEMINI_MAX_OUTPUT_TOKENS="1024"

# Transcripción (console.groq.com) — gratis, sin tarjeta
TRANSCRIPTION_API_KEY=""
TRANSCRIPTION_BASE_URL="https://api.groq.com/openai/v1"
TRANSCRIPTION_MODEL="whisper-large-v3-turbo"

# Buscador: "duckduckgo" (gratis, sin clave) o "brave" (DE PAGO desde 2026).
SEARCH_PROVIDER="duckduckgo"
BRAVE_API_KEY=""

# --------------------------------------------------------------------------
# 3. SESIONES Y ACCESO
# --------------------------------------------------------------------------
OWNER_EMAIL="neolafuente@gmail.com"
SESSION_MINUTES="10"          # duración de la sesión que autorizas
REQUEST_TTL_MINUTES="15"      # validez de los enlaces de autorización
WEB_ENABLED_ON_BOOT="false"   # false = tras cada reinicio la web queda APAGADA
MAX_PENDING_REQUESTS="20"
AUTH_REQUESTS_PER_HOUR="5"    # intentos por IP, evita que te inunden el correo
COOKIE_SECURE="true"          # ponlo en false solo para pruebas en http://localhost
PUBLIC_BASE_URL="https://factx.tudominio.com"   # se usa en los enlaces del email
SECURITY_DB_PATH="/data/security.db"

# --------------------------------------------------------------------------
# 4. AVISOS AL PROPIETARIO
# --------------------------------------------------------------------------
# Gmail exige una "contraseña de aplicación" (myaccount.google.com/apppasswords),
# NO tu contraseña normal. Requiere tener la verificación en 2 pasos activada.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="neolafuente@gmail.com"
SMTP_PASSWORD=""

# Telegram (opcional pero recomendado: llega en segundos al móvil con botones).
# Crea el bot con @BotFather y saca tu chat_id escribiéndole a @userinfobot.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --------------------------------------------------------------------------
# 5. TOPES DE GASTO — nada sale a internet sin pasar por aquí
# --------------------------------------------------------------------------
MAX_TRANSCRIPT_CHARS="6000"       # recorta lo que llega al LLM
MAX_FACTS_PER_RUN="8"             # claims por análisis
MAX_SEARCHES_PER_RUN="8"          # búsquedas por análisis
MAX_RUNS_PER_SESSION="3"          # análisis por sesión de 10 min
DAILY_LLM_CALL_BUDGET="80"        # llamadas al LLM por día (UTC)
DAILY_SEARCH_BUDGET="150"         # búsquedas por día (UTC)
DAILY_TRANSCRIPTION_BUDGET="60"   # transcripciones por día (UTC)
MAX_AUDIO_SECONDS="180"           # duración máxima de un audio/vídeo
MAX_UPLOAD_MB="20"                # tamaño máximo de subida

# --------------------------------------------------------------------------
# 6. DESPLIEGUE
# --------------------------------------------------------------------------
IMAGE="ghcr.io/neolafuente/fake_news_dector:latest"
CLOUDFLARE_TUNNEL_TOKEN=""
ONNX_THREADS="2"
