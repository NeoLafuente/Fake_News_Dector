# Keep the build context tiny: anything that is not needed to serve requests.
.git
.github
.venv
venv
__pycache__
**/__pycache__
*.pyc
*.pyo

# Research assets — the biggest offenders in this repo
notebooks/
uv.lock
requirements.txt
data/
downloads/
models/
mlruns/
*.ipynb

# Secrets must never end up in a layer
.env
.env.*
!.env.example
*.pem
*.key

# Local noise
.pytest_cache
.ruff_cache
.mypy_cache
*.log
.DS_Store
README.md
DEPLOY.md
